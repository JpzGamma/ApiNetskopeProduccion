# ===== Base =====
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# Instala deps del sistema (si usas psycopg2, etc. añade build-essentials/pg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ===== Dev =====
FROM base AS dev
# Montaremos el código como volumen en dev; solo copiamos archivos mínimos
COPY .env.dev ./.env
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ===== Prod =====
FROM base AS prod
COPY . .
# Usa variables de prod
RUN cp .env.prod .env
EXPOSE 8000
# Gunicorn + UvicornWorkers para producción
RUN pip install --no-cache-dir gunicorn
CMD ["gunicorn", "-k", "uvicorn.workers.UvicornWorker", "-w", "2", "-b", "0.0.0.0:8000", "app.main:app"]
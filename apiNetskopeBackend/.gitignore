# -------------------------
# Archivos de ENTORNO (muy importante)
# Ignora .env en raíz y en subcarpetas, en todos los formatos comunes.
# Mantén .env.example versionado.
# -------------------------
# Ignorar
*.env
.env
.env.*
**/.env
**/.env.*
**/*.env
# No ignorar ejemplos
!*.env.example
!**/.env.example
!**/*.env.example

# Por claridad (explícito para tus carpetas típicas)
apiNetskopeBackend/.env*
apiNetskopeFrontend/.env*
!apiNetskopeBackend/.env.example
!apiNetskopeFrontend/.env.example
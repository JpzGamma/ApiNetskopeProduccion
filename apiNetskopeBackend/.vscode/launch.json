{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (dev)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8001"],
      "jinja": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/apiNetskopeBackend",
      "envFile": "${workspaceFolder}/apiNetskopeBackend/.env.dev",
      "env": {
        "APP_ENV": "dev"
      },
      "justMyCode": true,
      "redirectOutput": true
    },
    {
      "name": "FastAPI (prod)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8001"],
      "jinja": true,
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/apiNetskopeBackend",
      "envFile": "${workspaceFolder}/apiNetskopeBackend/.env.prod",
      "env": {
        "APP_ENV": "prod"
      },
      "justMyCode": true,
      "redirectOutput": true
    }
  ]
}